{
  "job_type": "kd_white_box",
  "dataset": {
    "instruction_path": "train_filtered.json",
    "labeled_path": "train_labeled_with_teacher.json",
    "logits_path": "teacher_logits.jsonl",
    "template" : "./chat_template/chat_template_kd_qwen3.jinja",
    "seed": 42
  },
  "inference": {
    "enable_chunked_prefill": true,
    "seed": 42,
    "gpu_memory_utilization": 0.95,
    "temperature": 0.8,
    "trust_remote_code": true,
    "enforce_eager": false,
    "max_model_len": 4096,
    "max_new_tokens": 1024,
    "top_logits_num": 20
  },
  "distillation": {
    "kd_ratio": 0.5,
    "max_seq_length": 4096,
    "distillation_type": "reverse_kld",
    "top_logits_num": 20,
    "dtype": "bfloat16"
  },
  "models": {
    "teacher": "shisa-ai/shisa-v2.1-qwen3-8b",
    "student": "result_qwen3_kd_black"
  },
  "training": {
    "output_dir": "./result_qwen3_kd_white",
    "num_train_epochs": 1,
    "per_device_train_batch_size": 2,
    "gradient_accumulation_steps": 4,
    "max_length": 4096,
    "save_steps": 5000,
    "logging_steps": 10,
    "learning_rate": 2e-5,
    "weight_decay": 0.05,
    "warmup_ratio": 0.1,
    "lr_scheduler_type": "cosine",
    "bf16": true
  }
}
